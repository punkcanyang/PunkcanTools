{
  "name": "word2md",
  "version": "1.0.0",
  "description": "Convert Word documents (.docx) to Markdown",
  "main": "src/main.js",
  "type": "module",
  "bin": {
    "word2md": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "ui": "node src/server.js",
    "electron": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "word",
    "docx",
    "markdown",
    "converter"
  ],
  "author": "punkcan",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.punkcan.word2md",
    "productName": "Word2MD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
